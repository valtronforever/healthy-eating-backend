# Copy to .env and adjust. Every variable is optional in development.

# development | production
ENVIRONMENT=development

# Public URL of this server, as seen by MCP clients and the iOS app. Must be https in production.
BASE_URL=http://localhost:8000

# Postgres connection (docker-compose overrides this for the app container).
DATABASE_URL=postgresql+asyncpg://healthy:healthy@localhost:5432/healthy_eating

# Signs the login session cookie. Required in production: generate with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Sign in with any email address, without a social provider. Development only.
DEV_LOGIN_ENABLED=true

# Host ports used by docker-compose.
# APP_PORT=8000
# POSTGRES_PORT=5432

# Token lifetimes (seconds).
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_SECONDS=7776000

# Social login. A provider is shown on the login page only when all its variables are set.
# Redirect URI to register with each provider: {BASE_URL}/auth/callback/{google|microsoft|apple}

# Google: https://console.cloud.google.com/apis/credentials (OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft: https://entra.microsoft.com > App registrations
# (supported account types: "Accounts in any organizational directory and personal Microsoft accounts")
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Apple: https://developer.apple.com/account/resources (requires a paid Apple Developer account)
# APPLE_PRIVATE_KEY is the content of the .p8 key file; newlines may be written as \n.
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
