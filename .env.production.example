# Production settings for compose.production.yml. Copy to .env.production (git-ignored),
# fill in every value, and keep the file private. Guide: docs/self-hosting.md

# Public https URL of this server, without a trailing slash.
BASE_URL=https://food.example.com

# Generate both with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
POSTGRES_PASSWORD=

# Port on 127.0.0.1 that the reverse proxy forwards to.
APP_PORT=8000

# Never enable in production (the server refuses to start).
DEV_LOGIN_ENABLED=false

# Social login: set all variables of every provider you want to offer.
# Redirect URI to register: {BASE_URL}/auth/callback/{google|microsoft|apple}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Token lifetimes (seconds).
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_SECONDS=7776000
